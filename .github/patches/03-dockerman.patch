+local is_quot_complete = function(str)
+	local num = 0, w
+	require "math"
+
+	if not str then
+		return true
+	end
+
+	local num = 0, w
+	for w in str:gmatch("\"") do
+		num = num + 1
+	end
+
+	if math.fmod(num, 2) ~= 0 then
+		return false
+	end
+
+	num = 0
+	for w in str:gmatch("\'") do
+		num = num + 1
+	end
+
+	if math.fmod(num, 2) ~= 0 then
+		return false
+	end
+
+	return true
+end
+
+function contains(list, x)
+	for _, v in pairs(list) do
