+					first = true
+					luci.http.header('Content-Disposition', 'inline; filename="images.tar"')
+					luci.http.header('Content-Type', 'application\/x-tar')
+				end
+				luci.ltn12.pump.all(chunk, luci.http.write)
+			else
+				if not first then
